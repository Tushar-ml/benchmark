# copy to .env (gitignored? add it!) and fill in
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_TOKEN=
# MLFLOW_TRACKING_USERNAME=
# MLFLOW_TRACKING_PASSWORD=
MLFLOW_EXPERIMENT_NAME=DeepSeek-V4.1-Flash-coding
# server under test (OpenAI-compatible, JWT goes here)
BENCH_BASE_URL=http://localhost:8000/v1
BENCH_API_KEY=
BENCH_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
BENCH_CONCURRENCIES=1,4,8,16
BENCH_NUM_REQUESTS=64
BENCH_OUTPUT_TOKS=1024
CODING_DATASET=princeton-nlp/SWE-bench_Lite
# real server args are read from these running containers (prefill + decode); leave empty to skip
BENCH_SERVER=vllm
BENCH_SERVER_CONTAINERS=dynamo-pd-prefill-1,dynamo-pd-decode-1
# optional overrides: BENCH_GPU_TYPE=b300 BENCH_GPU_COUNT=8 BENCH_TOPOLOGY=pd-dp4ep4+dp4ep4
